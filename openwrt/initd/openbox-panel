#!/bin/sh /etc/rc.common
# Open-Box management panel service (security-hardened gateway)

USE_PROCD=1
START=98
STOP=11

OPENBOX_ROOT=/opt/open-box
NODE="$OPENBOX_ROOT/node/bin/node"
ENTRY="$OPENBOX_ROOT/panel/server/security-gateway.mjs"
DATA="$OPENBOX_ROOT/data"

resolve_panel_host() {
	# Allow an explicit override for advanced layouts, but otherwise bind only to the LAN address.
	[ -n "$OPENBOX_PANEL_HOST" ] && { printf '%s\n' "$OPENBOX_PANEL_HOST"; return 0; }

	lan_ip=$(uci -q get network.lan.ipaddr 2>/dev/null | tr ' ' '\n' | head -n 1 | cut -d/ -f1)
	if [ -z "$lan_ip" ] && command -v ip >/dev/null 2>&1; then
		lan_ip=$(ip -4 -o addr show br-lan 2>/dev/null | awk '{ print $4 }' | cut -d/ -f1 | head -n 1)
	fi
	[ -n "$lan_ip" ] || return 1
	printf '%s\n' "$lan_ip"
}

start_service() {
	if [ ! -x "$NODE" ]; then
		echo "openbox-panel: node runtime not found at $NODE" >&2
		return 1
	fi
	if [ ! -f "$ENTRY" ]; then
		echo "openbox-panel: security gateway not found at $ENTRY" >&2
		return 1
	fi

	PANEL_HOST=$(resolve_panel_host) || {
		echo "openbox-panel: unable to determine LAN IPv4 address; refusing to listen on 0.0.0.0" >&2
		return 1
	}
	mkdir -p "$DATA"

	procd_open_instance openbox-panel
	procd_set_param command "$NODE" "$ENTRY"
	# The gateway owns the LAN-facing port. The original backend is started by the gateway and
	# forced onto 127.0.0.1:2027, so backend root-level APIs are never directly exposed to LAN/WAN.
	procd_set_param env \
		PORT=2026 \
		HOST="$PANEL_HOST" \
		OPENBOX_BACKEND_PORT=2027 \
		OPENBOX_ROOT="$OPENBOX_ROOT" \
		LD_LIBRARY_PATH="$OPENBOX_ROOT/node/lib" \
		ZASHBOARD_DB_PATH="$DATA/openbox.sqlite"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
